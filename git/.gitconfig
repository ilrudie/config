[user]
	name = Ian Rudie
	signingkey = 1D2A02A0AAC7572D
	# email is set per-machine in ~/.gitconfig.local (see [include] at bottom):
	#   personal laptop -> ilrudie@gmail.com
	#   work laptop     -> ian.rudie@solo.io
# [url "ssh://git@github.com/"]
# 	insteadOf = https://github.com/
[gpg]
	program = gpg
[commit]
	gpgsign = true
[init]
	defaultBranch = main
[core]
	excludesFile = ~/.gitignore
	editor = vi 
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[safe]
	directory = /work
[pull]
	rebase = true

# Per-machine identity — NOT tracked, NOT stowed. Create on each machine:
#   personal:  git config -f ~/.gitconfig.local user.email ilrudie@gmail.com
#   work:      git config -f ~/.gitconfig.local user.email ian.rudie@solo.io
# A missing include is silently ignored, so a fresh machine will refuse to
# commit until you set an email here (a good failsafe against mis-attribution).
[include]
	path = ~/.gitconfig.local
