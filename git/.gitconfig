[user]
	signingkey = 1D2A02A0AAC7572D
	name = Ian Rudie
	email = ian.rudie@solo.io
# [url "ssh://git@github.com/"]
# 	insteadOf = https://github.com/
[gpg]
	program = gpg
[commit]
	gpgsign = true
[init]
	defaultBranch = main
[core]
	excludesFile = ~/.gitignore
	editor = vi 
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[safe]
	directory = /work
[pull]
	rebase = true
