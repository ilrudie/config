# ~/.zsh_aliases — entry point sourced by ~/.zshrc.
#
# Loads shared aliases, then the current platform's set, auto-detected at
# shell startup via $OSTYPE. No per-machine setup step needed: the same files
# work on macOS and Linux, and each host self-selects its clipboard bindings.

adir="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/aliases"
source "$adir/common.zsh"
case "$OSTYPE" in
  darwin*) source "$adir/darwin.zsh" ;;
  linux*)  source "$adir/linux.zsh"  ;;
esac
unset adir
